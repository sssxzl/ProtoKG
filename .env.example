# DeepSeek API 配置(从 https://platform.deepseek.com 申请)
# 复制本文件为 .env 并填入真实 key:
#   cp .env.example .env
# .env 已在 .gitignore 中,不会进 git
DEEPSEEK_API_KEY=sk-your-key-here

# 可选:自定义 endpoint(任何 OpenAI 兼容服务都行, 比如 ollama / vllm)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
