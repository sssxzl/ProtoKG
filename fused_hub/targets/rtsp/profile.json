{
  "protocol": "rtsp",
  "transport": "tcp",
  "encoding": "text",
  "default_url": "rtsp://127.0.0.1:8554/",
  "resources_file": "rtsp_streams.json",
  "templates_file": "rtsp_request_templates.json",
  "raw_format": {
    "line_ending": "\r\n",
    "request_line": "{method} {url} {version}",
    "version": "RTSP/1.0",
    "header_line": "{key}: {value}",
    "trailing_blank_line": true
  },
  "message_schema": {
    "hint": "消息实例必须含 \"url\" 字段（完整请求 URL，用 <server> 占位服务器地址、<stream> 占位流名；SETUP 的 url 用 /track{N}（N 从 1 递增）；PLAY/PAUSE/TEARDOWN 等尾斜杠方法的 url 以 / 结尾；其余方法用裸 <stream>）。url 结构是你对协议会话语义的理解，请如实生成。其余关键头部字段（如 Transport/Session/CSeq）也作为字段给出。"
  },
  "allowed_methods": [
    "OPTIONS",
    "DESCRIBE",
    "SETUP",
    "TEARDOWN",
    "PLAY",
    "PAUSE",
    "GET_PARAMETER",
    "SET_PARAMETER"
  ],
  "url_placeholders": {
    "<server>": "127.0.0.1:8554",
    "<stream>": "mp3AudioTest"
  },
  "boundary_probe": {
    "transport_tokens": [
      "interleaved=0-1",
      "client_port=50000-50001",
      "RTP/AVP;unicast;client_port=50000-50001",
      "RTP/AVP/TCP;unicast;interleaved=0-1"
    ],
    "note": "定向变异字典里协议特有的 Transport 组合串（RTSP 语义）。下沉到 profile 是为了保持 boundary_probe.py 协议无关——换协议 = 加一份 profile.json。生成逻辑见 core/fused/downstream/boundary_probe.py::generate_targeted_dict。"
  },
  "seedgen": {
    "canonical_flow": [
      "OPTIONS",
      "DESCRIBE",
      "SETUP",
      "PLAY",
      "TEARDOWN"
    ],
    "danger": false,
    "state_changing": [
      "SETUP",
      "PLAY",
      "PAUSE",
      "TEARDOWN"
    ],
    "environments": {
