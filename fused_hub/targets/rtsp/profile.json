    "action_boundary": {
      "double_setup": {
        "dim": "track_number",
        "legal": "对不同 track 分别 SETUP（track1≠track2，多轨会话）",
        "illegal": "对同一 track 连续两次 SETUP（track1==track1，触发 Matroska UAF）"
      },
      "interleave_seq": {
        "dim": "transport_switch",
        "legal": "会话内传输方式保持一致（全 interleaved 或全普通）",
        "illegal": "interleaved 与普通 SETUP 之间切换（触发 UAF）"
      },
      "uaf_seq": {
        "dim": "re_setup_after_teardown",
        "legal": "SETUP → TEARDOWN（终止会话，不重建）",
        "illegal": "TEARDOWN 后再 SETUP（重建引用已释放资源，触发 UAF）"
