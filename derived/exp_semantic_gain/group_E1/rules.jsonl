{"rule_id": "r24619796f05517b2", "evidence": {"evidence_id": "e73ff652d9ee7", "spec_version": "RFC 3261", "section_path": ["characters are used as a magic cookie (7 is deemed sufficient to", "Sending the Request"], "source_anchor": "file:rfc3261.txt#@2317", "span_text": "Independent\n   of which URI is used as input to the procedures of [4], if the\n   Request-URI specifies a SIPS resource, the UAC MUST follow the\n   procedures of [4] as if the input URI were a SIPS URI.", "span_start": 110695, "span_end": 110896, "evidence_kind": "normative", "explicitness": "explicit", "source_class": "normative_spec"}, "constraint": {"target_field": "Request-URI", "operator": "eq", "operand": ["SIPS"], "operand_source": "constant", "operand_ref": null, "applies_to_state": [], "applies_to_method": [], "expected_behavior": "", "sender_role": "client", "receiver_role": "server", "precondition": null}, "subject_type": "field", "subject_name": "Request-URI", "rule_state": "authoritative", "supersedes": null, "model_confidence": 1.0, "validated": true}
{"rule_id": "r1d3b15784925279d", "evidence": {"evidence_id": "ecf572c68c78f", "spec_version": "RFC 3261", "section_path": ["SIP Messages", "Bodies", "Message Body Type"], "source_anchor": "file:rfc3261.txt#@1847", "span_text": "The Internet media type of the message body MUST be given by the\n   Content-Type header field.", "span_start": 90408, "span_end": 90502, "evidence_kind": "normative", "explicitness": "explicit", "source_class": "normative_spec"}, "constraint": {"target_field": "Content-Type", "operator": "present", "operand": [], "operand_source": "constant", "operand_ref": null, "applies_to_state": [], "applies_to_method": [], "expected_behavior": "", "sender_role": "client", "receiver_role": "server", "precondition": null}, "subject_type": "field", "subject_name": "Content-Type", "rule_state": "authoritative", "supersedes": null, "model_confidence": 1.0, "validated": true}
{"rule_id": "ra4163b7e9510c02d", "evidence": {"evidence_id": "ebd14a23cfee6", "spec_version": "RFC 3261", "section_path": ["SIP Messages", "Bodies", "Message Body Type"], "source_anchor": "file:rfc3261.txt#@1848", "span_text": "If the body has undergone any encoding\n   such as compression, then this MUST be indicated by the Content-\n   Encoding header field; otherwise, Content-Encoding MUST be omitted.", "span_start": 90504, "span_end": 90681, "evidence_kind": "normative", "explicitness": "explicit", "source_class": "normative_spec"}, "constraint": {"target_field": "Content-Encoding", "operator": "present", "operand": [], "operand_source": "constant", "operand_ref": null, "applies_to_state": [], "applies_to_method": [], "expected_behavior": "", "sender_role": "client", "receiver_role": "server", "precondition": null}, "subject_type": "field", "subject_name": "Content-Encoding", "rule_state": "authoritative", "supersedes": null, "model_confidence": 1.0, "validated": true}
