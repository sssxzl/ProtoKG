# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Local env
.venv/
venv/
.env

# IDE
.idea/
.vscode/
*.swp

# Runtime / fuzz artefacts (not committed)
kb/spec/<task_id>/spec_chunks.jsonl
kb/vuln/<task_id>/vuln_samples.jsonl
kb/runtime_evidence/*.jsonl
*.log
# ★ 例外（K-2c，2026-11-02）：kb 下的 **client.log** 是**流量素材**，
#   与同目录的 pcap / ndjson / csv **同类**（那些都已入库）⇒ 不该被
#   全局 ``*.log`` 规则排除。
#   ★ 它是 ``profile.traffic_schema.log_files`` 声明的**底料日志类型**
#     （``core/fused/downstream/action_seq.py:1392`` 按该白名单在流量目录里
#     找日志 ⇒ 找不到 ⇒ 来源② traffic-capture 底料**永久失效**）
#     ⇒ 换机器 / CI 必然缺（实测 CI 上 traffic 字段推断恒返回 []）。
!kb/**/client.log
*.tmp

# Generated artefacts (regenerable, do not commit)
generated/

# 临时目录（运行期产生，不入库）
seeds_mutated/

# 种子目录（与 Initial seeds/ 同源，体积大，不入 git）
seeds/rtsp/test cases/

# Derived artefacts (中间产物，可由 kb/ 重建)
# ★ 用 `derived/*` 而非 `derived/` —— git **不会进入被排除的目录**，
#   写 `derived/` 的话下面的 `!` 例外对里面的文件无效。
derived/*
#   例外：B 阶段的人工标注集**进版本库**（见下）。
!derived/exp_semantic/
#   标注集内部只放行「人工判断产物」；中间产物（模型缓存等）仍排除。
derived/exp_semantic/*
!derived/exp_semantic/candidates_frozen.jsonl
!derived/exp_semantic/candidates_train.jsonl
!derived/exp_semantic/candidates_holdout.jsonl
!derived/exp_semantic/truth/

# ── 以下为 2026-11-01 补充 ──

# 第三方源码备份（kb 内嵌的 pjproject 备份，51MB / 2386 文件）
#   这些是外部项目的快照，不是本项目的知识资产。
kb/*/_bak_*/

# 已下线协议的抓包归档（local/*.tar.gz，93MB）
#   ftp / dns / dtls / ssh / tls 已裁剪出目标协议范围，这些归档是历史物证，
#   保留在本地即可，不进版本库。
local/*.tar.gz

# 本地凭据与密钥（安全红线：绝不进版本库）
*.pem
*.key
.github_token
.env.*
!.env.example

# QA 本地工作区（备份 / 探针副本 / 临时脚本），非项目资产
# ★ 用 `/qa/`（前导斜杠）而不是 `qa/`：
#   `qa/` 会匹配**任意层级**名为 qa 的目录 ⇒ 连入库的 `tools/qa/`（CI 验收工具）都被排除。
#   加前导斜杠后只匹配仓库根的 `qa/`。
/qa/

# 护栏验收脚本的产物目录（tools/qa/run_guarded_pytest.py 默认写这里）
_ci_artifacts/

# CRLF 鲁棒性探针的仓内临时目录（tests/fused/test_annotation_tools.py 生成）。
#   目录名带进程号，正常跑完会自清理；但进程被 kill 时会残留 ⇒ 顺手排除掉，
#   免得误提交（里面是被物化成 CRLF 的脚本副本）。
_crlf_probe_*/

# B-10 实验产物（预登记冻结后的实测结果 + 冻结候选集 + LLM 缓存）
#   与标注集同理：实验结论**不可重建**（含 LLM 调用记录），必须可审计。
!derived/exp_semantic_gain/
!derived/exp_semantic_gain/candidates_frozen.jsonl
!derived/exp_semantic_gain/llm_cache.jsonl
!derived/exp_semantic_gain/results.json

# 消融/实验的运行时输出目录（种子 .raw + 构建日志）⇒ 可重建，不入库。
/out/

# 消融脚本的运行时中间工件目录（最终工件已归档到 local/ablation_rtsp/）。
tools/qa/ablation/_out/

# 编码护栏产物与原始坏版本备份（本地留存，不入库）
local/encoding_backup/
local/encoding_guard_result.json

# ── 中枢重设计（2026-11-08）：中枢共用一套（derived/hub/）────────────────
# 派生产物（中枢 facts / 图 / 社区 / 种子 / 护栏输出）⇒ 全部可重建，不入库。
/derived/hub/
/derived/per_source/
/derived/seeds/
/derived/spec/
/derived/source_blocks/
/derived/analysis/
/derived/exp_semantic/
/derived/exp_semantic_gain/
/qa/
/out/
compare/out/
# 临时探针（CRLF 检测的副产品）
_crlf_probe_*
