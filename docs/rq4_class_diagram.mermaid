classDiagram
    direction TB

    class RQ4Config {
        +str protocols = "rtsp,sip,smtp"
        +str groups = "protorag,baseline"
        +int reps = 1
        +int duration_sec = 10800
        +int skipcount = 5
        +str seed_root = "/home/zxy/rq4/seeds"
        +str out_root = "/home/zxy/rq4/out"
        +str memory = "2g"
        +bool dry_run = false
        +validate() list
    }

    class ProtocolSpec {
        +str key
        +str image
        +str proto
        +str net
        +str in_dir
        +str work_dir
        +str options
        +str dict_mode
        +str cleanup
        +seed_mount_args(seed_root, group) list
        +docker_run_args(group, rep, cfg) list
        +stats_path(outdir) str
        +tar_name(outdir) str
    }

    class ProtocolRegistry {
        -dict specs
        +get(key) ProtocolSpec
        +all() list
        +static build_head_8573ec8() ProtocolRegistry
    }

    class SeedCorpus {
        +str protocol
        +str group
        +str origin
        +int file_count
        +int region_count
        +int dict_tokens
        +str dict_source
        +list md5_manifest
        +verify() bool
        +describe() str
    }

    class MatchedCorpus {
        +str protocol
        +int target_files
        +int target_regions
        +list subset
        +select_by_region_count(corpus, target) MatchedCorpus
        +materialize(dst_dir) bool
    }

    class DockerRunner {
        +str image
        +str container_name
        +int cpus = 1
        +str memory = "2g"
        +remove_existing() bool
        +run(cmd, mounts, name) str
        +logs(name) str
        +wait(name, timeout) int
        +exec_cat(name, path) str
        +exec_tar(name, dir, name2) bytes
        +kill(name) bool
    }

    class ContainerHandle {
        +str name
        +str protocol
        +str group
        +int rep
        +str outdir
        +str work_dir
        +is_running() bool
        +stats_path() str
    }

    class StatsSnapshot {
        +int timestamp
        +int start_time
        +int last_update
        +int fuzz_sec
        +int execs_done
        +float execs_per_sec
        +int paths_total
        +int paths_found
        +float bitmap_cvg
        +float stability
        +int unique_crashes
        +int unique_hangs
        +str command_line
        +parse(text) StatsSnapshot
        +is_alive_since(prev) bool
    }

    class CoverageSeries {
        +list snapshots
        +append(snap)
        +final() StatsSnapshot
        +bitmap_at_execs(n) float
        +bitmap_curve() list
        +median_exec_aligned_bitmap() float
    }

    class CovOverTime {
        +str csv_path
        +list rows
        +parse(text)
        +last() dict
        +line_coverage() float
        +branch_coverage() float
    }

    class SummaryWriter {
        +str out_path
        +list rows
        +add(container, snapshot, series, cov, seed_corpus)
        +write_csv()
        +str columns
    }

    class DryRunner {
        +int duration_sec = 180
        +str group = "protorag"
        +run_protocol(spec) DryRunResult
        +assert_common(handle) list
        +assert_rtsp(handle) list
        +assert_sip(handle) list
        +assert_smtp(handle) list
    }

    class DryRunResult {
        +str protocol
        +bool passed
        +list failures
        +list evidence
    }

    class RQ4Launcher {
        +RQ4Config cfg
        +ProtocolRegistry registry
        +list handles
        +prepare() bool
        +launch_all() list
        +cleanup_names()
        +dry_run_print()
    }

    class RQ4Collector {
        +RQ4Config cfg
        +list handles
        +snapshot_once(handle) StatsSnapshot
        +poll_loop(interval_sec) CoverageSeries
        +wait_all(timeout_sec) bool
        +collect_artifacts(handle) bool
        +summarize() SummaryWriter
    }

    RQ4Config --> ProtocolRegistry : 驱动
    ProtocolRegistry o-- ProtocolSpec : 包含
    ProtocolSpec ..> SeedCorpus : 解析种子信息
    SeedCorpus ..> MatchedCorpus : 可裁剪为数量对齐组
    MatchedCorpus ..> SeedCorpus : 产出子集语料
    RQ4Launcher --> DockerRunner : 驱动
    RQ4Launcher --> ContainerHandle : 产出
    RQ4Collector --> DockerRunner : 驱动
    RQ4Collector --> ContainerHandle : 读取
    DockerRunner ..> StatsSnapshot : exec_cat 产出
    StatsSnapshot --> CoverageSeries : 累积
    CoverageSeries --> SummaryWriter : 汇总
    CovOverTime --> SummaryWriter : 汇总
    SeedCorpus --> SummaryWriter : 汇总 (自证仅种子不同)
    RQ4Launcher ..> DryRunner : 复用参数表
    DryRunner --> DryRunResult : 产出
    DryRunner --> DockerRunner : 驱动
