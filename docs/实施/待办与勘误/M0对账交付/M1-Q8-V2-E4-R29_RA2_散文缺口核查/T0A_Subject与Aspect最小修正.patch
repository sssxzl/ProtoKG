+def _prose_subject_type(name: str, norm: dict) -> str:
+    """散文知识的 Subject 类型：参与方 ⇒ actor；其余 ⇒ protocol。
+
+    ★ 只复用既有类型（actor / protocol / header），不新增主体类型。
+    ★ 只有 name 明确是头字段（norm 带 entity_type=header 或含连字符且全大写）
+      才保留 header —— 避免把「client」这类参与方伪装成邮件头。
+    """
+    low = str(name or "").strip().lower()
+    if norm.get("entity_type") == "header":
+        return "header"
+    if low in _PROSE_ACTOR_HINTS:
+        return "actor"
+    if any(k in low for k in ("client", "server", "parties", "user",
+                              "implementation", "agent", "sender", "receiver")):
+        return "actor"
+    return "protocol"            # 扩展名/关键字（如 STARTTLS）按协议级实体
+
