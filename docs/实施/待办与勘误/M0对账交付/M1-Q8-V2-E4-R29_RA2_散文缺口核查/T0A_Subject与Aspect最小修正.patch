+
+#: R29-RA2/T0-A：协议参与方词表（散文知识的主体不是头字段）
+_PROSE_ACTOR_HINTS = {
+    "client", "server", "user", "agent", "implementation", "party",
+    "parties", "both parties", "clients and servers", "sender", "receiver",
+    "smtp client", "smtp server", "smtp agent", "administrator",
+}
