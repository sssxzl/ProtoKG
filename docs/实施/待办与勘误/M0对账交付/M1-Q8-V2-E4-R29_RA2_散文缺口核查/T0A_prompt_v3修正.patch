+# ===========================================================================
+# R29-RA2/F2：文档级散文缓存（影子）
+# ===========================================================================
+#   ★ 与批次级旧缓存并存：旧文件（单协议单条目、complete=false）**一律不读**，
+#     76 条历史记录继续隔离；新缓存按 (协议, 文档) 分文件，各自独立完成状态。
+
+_DOC_CACHE_SCHEMA = "prose-cache-doc-v1"
+
+
+def _doc_cache_dir(protocol: str) -> Path:
+    return _cache_path(protocol).parent / f"{protocol}.prose.d"
+
+
+def _doc_cache_file(protocol: str, doc: str) -> Path:
+    safe = "".join(c if (c.isalnum() or c in "._-") else "_" for c in doc)
+    return _doc_cache_dir(protocol) / f"{safe}.json"
+
+
+def _block_signature(blocks: list[dict]) -> str:
+    """选块集合指纹：起始行 + 长度 + 块内容哈希（避免直接拼接的边界歧义）。"""
+    parts = []
+    for b in blocks:
+        t = str(b.get("text", ""))
+        parts.append(f"{b.get('start')}:{len(t)}:"
+                     f"{hashlib.sha256(t.encode('utf-8')).hexdigest()[:16]}")
+    return hashlib.sha256("|".join(parts).encode("utf-8")).hexdigest()
+
+
+def _doc_key(protocol: str, doc: str, block_sig: str, src_sha: str,
+             parser_version: str) -> str:
+    """文档级键：原始文件 SHA + 选块指纹 + 解析器/prompt/模型/schema 版本。"""
+    from core.fused.extraction.cache_key import cache_key as _ck
+    return _ck(prompt_version=PROSE_SEMANTICS_PROMPT_VERSION,
+               input_fingerprint=f"{doc}\x00{src_sha}\x00{block_sig}",
+               temperature=0.1, max_tokens=_MAX_TOKENS,
+               prompt_digest=_hash_text(_PROMPT),
+               parser_version=parser_version,
+               schema_version=_DOC_CACHE_SCHEMA)
+
+
+def _doc_meta(blocks: list[dict]) -> dict:
+    """按文档汇总 (块集合, 块指纹, 原始 SHA)。原始 SHA 缺失记空串，不臆造。"""
+    meta: dict[str, dict] = {}
+    for b in blocks:
+        d = b.get("doc") or ""
+        m = meta.setdefault(d, {"blocks": [], "src_sha256": "",
+                                "has_src": False, "conflict": False})
+        m["blocks"].append(b)
+        s = str(b.get("src_sha256") or "")
+        if m.get("conflict"):
+            continue                      # 已判冲突 ⇒ 保持不可用（粘性）
+        if not s:
+            # 部分块无来源 ⇒ 整份文档来源不可证（同样粘性）
+            m["src_sha256"], m["has_src"], m["conflict"] = "", False, True
+            continue
+        if not m["has_src"]:
+            m["src_sha256"], m["has_src"] = s, True
+        elif m["src_sha256"] != s:
+            m["src_sha256"], m["has_src"], m["conflict"] = "", False, True
+    for d, m in meta.items():
+        m["block_sig"] = _block_signature(m["blocks"])
+    return meta
+
+
+def _load_doc_caches(protocol: str, meta: dict, parser_version: str
+                     ) -> tuple[dict[str, list[dict]], set[str]]:
+    """读文档级缓存。只接受 schema/key/来源三者全部一致的 complete=true。"""
+    hit: dict[str, list[dict]] = {}
+    miss: set[str] = set()
+    for doc, m in meta.items():
+        f = _doc_cache_file(protocol, doc)
+        if not f.is_file():
+            miss.add(doc); continue
+        try:
+            d = json.loads(f.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            miss.add(doc); continue
+        if not isinstance(d, dict):
+            miss.add(doc); continue
+        if d.get("schema") != _DOC_CACHE_SCHEMA or d.get("complete") is not True:
+            miss.add(doc); continue
+        if d.get("doc") != doc:
+            miss.add(doc); continue
+        # 来源必须可证且一致：任一侧为空（含来源冲突）⇒ 拒收，不猜
+        if not m["src_sha256"] or d.get("doc_sha256") != m["src_sha256"]:
+            miss.add(doc); continue
+        if d.get("key") != _doc_key(protocol, doc, m["block_sig"],
+                                    m["src_sha256"], parser_version):
+            miss.add(doc); continue
+        if not isinstance(d.get("items"), list):
+            miss.add(doc); continue
+        # 内部条目归属必须与文件名一致，否则整条缓存拒收（防跨文档污染）
+        if any((it.get("doc") if isinstance(it, dict) else None) != doc
+               for it in d["items"]):
+            miss.add(doc); continue
+        hit[doc] = list(d["items"])
+    return hit, miss
+
+
+def _save_doc_caches(protocol: str, meta: dict, items: list[dict],
+                     parser_version: str, doc_ok: dict[str, bool],
+                     only_docs: set[str] | None = None) -> None:
+    """按文档写缓存：只写本次实际处理且成功的文档；失败文档不写（保持无缓存）。"""
+    by_doc: dict[str, list[dict]] = {d: [] for d in meta}
+    for it in items or []:
+        d = it.get("doc")
+        if d in by_doc:
+            by_doc[d].append(it)
+    out_dir = _doc_cache_dir(protocol)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    for doc, m in meta.items():
+        if only_docs is not None and doc not in only_docs:
+            continue
+        if not doc_ok.get(doc):
+            continue
+        if not m["src_sha256"]:      # 来源不可证 ⇒ 不写缓存（写入也会被拒读）
+            continue
+        payload = {"schema": _DOC_CACHE_SCHEMA,
+                   "doc": doc,
+                   "doc_sha256": m["src_sha256"],
+                   "block_sig": m["block_sig"],
+                   "key": _doc_key(protocol, doc, m["block_sig"],
+                                   m["src_sha256"], parser_version),
+                   "complete": True,
+                   "status": "success_nonempty" if by_doc[doc] else "success_empty",
+                   "items": by_doc[doc]}
+        f = _doc_cache_file(protocol, doc)
+        tmp = f.with_suffix(".json.tmp")
+        tmp.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
+        tmp.replace(f)
+
