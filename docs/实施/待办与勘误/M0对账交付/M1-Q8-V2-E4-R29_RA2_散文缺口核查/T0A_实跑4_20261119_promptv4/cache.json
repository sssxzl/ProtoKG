{"schema": "prose-cache-doc-v1", "doc": "rfc3207.txt", "doc_sha256": "b004a203791a1ca664d39a49d73369f88f5f3870486a6639e3f833df2118e4ac", "block_sig": "380c627d0057e441ceec4cc316429dfe85cae4279c0394e5e549111d42bc26e1", "key": "262459a286a1d9b12e1bad8bf8f2aabea60e88ed4c45223decb85a80a0f3ab4c", "complete": true, "status": "success_nonempty", "items": [{"doc": "rfc3207.txt", "entity": "SMTP", "meaning": "该文档描述了一个 SMTP 服务扩展，允许 SMTP 服务器和客户端使用 TLS 提供私密、经过认证的通信。", "constraint": "", "span": 22, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "TLS", "meaning": "TLS 使 SMTP 代理能够保护其部分或全部通信免受窃听者和攻击者的侵害。", "constraint": "", "span": 25, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "STARTTLS 是此处定义的 SMTP 服务名称。", "constraint": "", "span": 76, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "STARTTLS 是与该扩展关联的 EHLO 关键字值。", "constraint": "", "span": 78, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "STARTTLS 关键字没有参数。", "constraint": "", "span": 80, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "定义了一个新的 SMTP 动词 STARTTLS。", "constraint": "", "span": 82, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "STARTTLS 关键字用于告知 SMTP 客户端，SMTP 服务器当前能够协商使用 TLS。", "constraint": "", "span": 88, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "STARTTLS 命令的格式为 STARTTLS，且不带参数。", "constraint": "", "span": 96, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "客户端发出 STARTTLS 命令后，服务器以 220、501 或 454 之一回复。", "constraint": "", "span": 100, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "454", "meaning": "客户端收到 454 响应后，必须根据本地策略决定是否继续 SMTP 会话。", "constraint": "客户端收到 454 响应后必须决定是否继续 SMTP 会话", "span": 119, "action": "决定是否继续 SMTP 会话", "object": "SMTP 会话", "strength": "", "polarity": "", "keyword_raw": "must", "condition": "If the client receives the 454 response", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "client", "subject_span": 119}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "公开引用的 SMTP 服务器不得要求使用 STARTTLS 扩展才能在本地投递邮件。", "constraint": "公开引用的 SMTP 服务器不得要求使用 STARTTLS 扩展才能在本地投递邮件", "span": 129, "action": "要求使用 STARTTLS 扩展", "object": "STARTTLS 扩展", "strength": "MUST", "polarity": "negative", "keyword_raw": "MUST NOT", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "publicly-referenced SMTP server", "subject_span": 129}, {"doc": "rfc3207.txt", "entity": "SMTP server", "meaning": "任何 SMTP 服务器都可以基于 TLS 协商期间提供的认证拒绝中继邮件。", "constraint": "", "span": 136, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "SMTP server", "meaning": "非公开引用的 SMTP 服务器可以基于 TLS 协商期间提供的认证拒绝任何中继或本地投递邮件。", "constraint": "", "span": 138, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "530", "meaning": "要求客户端先进行 TLS 协商的服务器，对除 NOOP、EHLO、STARTTLS 或 QUIT 之外的每条命令都应返回 530 回复码。", "constraint": "对除 NOOP、EHLO、STARTTLS 或 QUIT 之外的每条命令应返回 530 回复码", "span": 148, "action": "返回 530 回复码", "object": "除 NOOP、EHLO、STARTTLS 或 QUIT 之外的每条命令", "strength": "SHOULD", "polarity": "positive", "keyword_raw": "SHOULD", "condition": "A SMTP server that is not publicly referenced may choose to require that the client perform a TLS negotiation before accepting any commands", "exception": "other than NOOP, EHLO, STARTTLS, or QUIT", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "server", "subject_span": 148}, {"doc": "rfc3207.txt", "entity": "5.7.0", "meaning": "如果使用 ENHANCEDSTATUSCODES 扩展，应返回状态码 5.7.0。", "constraint": "应返回状态码 5.7.0", "span": 153, "action": "返回状态码 5.7.0", "object": "状态码", "strength": "SHOULD", "polarity": "positive", "keyword_raw": "SHOULD", "condition": "If the client and server are using the ENHANCEDSTATUSCODES ESMTP extension", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "server", "subject_span": 153}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "收到 STARTTLS 命令的 220 响应后，客户端必须在发出任何其他 SMTP 命令之前开始 TLS 协商。", "constraint": "客户端必须在发出任何其他 SMTP 命令之前开始 TLS 协商", "span": 155, "action": "开始 TLS 协商", "object": "TLS 协商", "strength": "MUST", "polarity": "positive", "keyword_raw": "MUST", "condition": "After receiving a 220 response to a STARTTLS command", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "client", "subject_span": 155}, {"doc": "rfc3207.txt", "entity": "TLS handshake", "meaning": "如果客户端发出 STARTTLS 后发现某种失败使其无法开始 TLS 握手，则应中止连接。", "constraint": "应中止连接", "span": 158, "action": "中止连接", "object": "连接", "strength": "SHOULD", "polarity": "positive", "keyword_raw": "SHOULD", "condition": "If, after having issued the STARTTLS command, the client finds out that some failure prevents it from actually starting a TLS handshake", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "client", "subject_span": 158}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "如果 SMTP 客户端使用流水线，STARTTLS 命令必须是组中的最后一条命令。", "constraint": "STARTTLS 命令必须是组中的最后一条命令", "span": 162, "action": "作为组中的最后一条命令", "object": "STARTTLS 命令", "strength": "", "polarity": "", "keyword_raw": "must", "condition": "If the SMTP client is using pipelining as defined in RFC 2920", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "SMTP client", "subject_span": 162}, {"doc": "rfc3207.txt", "entity": "TLS handshake", "meaning": "TLS 握手完成后，双方必须立即根据所获得的认证和隐私决定是否继续。", "constraint": "双方必须立即根据所获得的认证和隐私决定是否继续", "span": 172, "action": "决定是否继续", "object": "会话继续", "strength": "MUST", "polarity": "positive", "keyword_raw": "MUST", "condition": "After the TLS handshake has been completed", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "both parties", "subject_span": 172}, {"doc": "rfc3207.txt", "entity": "SMTP client", "meaning": "如果 SMTP 客户端认为认证或隐私级别不够高，应在 TLS 协商完成后立即发出 SMTP QUIT 命令。", "constraint": "应在 TLS 协商完成后立即发出 SMTP QUIT 命令", "span": 181, "action": "发出 SMTP QUIT 命令", "object": "SMTP QUIT 命令", "strength": "SHOULD", "polarity": "positive", "keyword_raw": "SHOULD", "condition": "If the SMTP client decides that the level of authentication or privacy is not high enough for it to continue", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "SMTP client", "subject_span": 181}, {"doc": "rfc3207.txt", "entity": "SMTP server", "meaning": "如果 SMTP 服务器认为认证或隐私级别不够高，应对客户端的每条 SMTP 命令（QUIT 除外）回复 554。", "constraint": "应对客户端的每条 SMTP 命令（QUIT 除外）回复 554", "span": 184, "action": "回复 554", "object": "客户端的每条 SMTP 命令（QUIT 除外）", "strength": "SHOULD", "polarity": "positive", "keyword_raw": "SHOULD", "condition": "If the SMTP server decides that the level of authentication or privacy is not high enough for it to continue", "exception": "other than a QUIT command", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "SMTP server", "subject_span": 184}, {"doc": "rfc3207.txt", "entity": "SMTP protocol", "meaning": "TLS 握手完成后，SMTP 协议重置为初始状态。", "constraint": "", "span": 205, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "server", "meaning": "服务器必须丢弃从客户端获得的、并非来自 TLS 协商本身的任何知识（如 EHLO 参数）。", "constraint": "服务器必须丢弃从客户端获得的、并非来自 TLS 协商本身的任何知识", "span": 208, "action": "丢弃知识", "object": "从客户端获得的、并非来自 TLS 协商本身的知识", "strength": "MUST", "polarity": "positive", "keyword_raw": "MUST", "condition": "Upon completion of the TLS handshake", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "server", "subject_span": 208}, {"doc": "rfc3207.txt", "entity": "client", "meaning": "客户端必须丢弃从服务器获得的、并非来自 TLS 协商本身的任何知识（如 SMTP 服务扩展列表）。", "constraint": "客户端必须丢弃从服务器获得的、并非来自 TLS 协商本身的任何知识", "span": 211, "action": "丢弃知识", "object": "从服务器获得的、并非来自 TLS 协商本身的知识", "strength": "MUST", "polarity": "positive", "keyword_raw": "MUST", "condition": "Upon completion of the TLS handshake", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "client", "subject_span": 211}, {"doc": "rfc3207.txt", "entity": "EHLO", "meaning": "客户端应在成功 TLS 协商后发送 EHLO 命令作为第一条命令。", "constraint": "应在成功 TLS 协商后发送 EHLO 命令作为第一条命令", "span": 214, "action": "发送 EHLO 命令", "object": "EHLO 命令", "strength": "SHOULD", "polarity": "positive", "keyword_raw": "SHOULD", "condition": "after a successful TLS negotiation", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "client", "subject_span": 214}, {"doc": "rfc3207.txt", "entity": "SMTP service extensions", "meaning": "TLS 握手后 EHLO 返回的 SMTP 服务扩展列表可能与握手前不同。", "constraint": "", "span": 217, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}, {"doc": "rfc3207.txt", "entity": "TLS session", "meaning": "客户端和服务器都必须知道是否存在活动的 TLS 会话。", "constraint": "客户端和服务器都必须知道是否存在活动的 TLS 会话", "span": 226, "action": "知道是否存在活动的 TLS 会话", "object": "活动的 TLS 会话", "strength": "MUST", "polarity": "positive", "keyword_raw": "MUST", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "client and server", "subject_span": 226}, {"doc": "rfc3207.txt", "entity": "TLS session", "meaning": "如果 TLS 会话已处于活动状态，客户端不得尝试启动 TLS 会话。", "constraint": "客户端不得尝试启动 TLS 会话", "span": 227, "action": "启动 TLS 会话", "object": "TLS 会话", "strength": "MUST", "polarity": "negative", "keyword_raw": "MUST NOT", "condition": "if a TLS session is already active", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "client", "subject_span": 227}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "TLS 握手完成后，服务器不得在响应 EHLO 命令时返回 STARTTLS 扩展。", "constraint": "服务器不得在响应 EHLO 命令时返回 STARTTLS 扩展", "span": 228, "action": "返回 STARTTLS 扩展", "object": "STARTTLS 扩展", "strength": "MUST", "polarity": "negative", "keyword_raw": "MUST NOT", "condition": "after a TLS handshake has completed", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "server", "subject_span": 228}, {"doc": "rfc3207.txt", "entity": "STARTTLS", "meaning": "STARTTLS 在 Submission 端口上是有效的 ESMTP 扩展。", "constraint": "", "span": 232, "action": "", "object": "", "strength": "", "polarity": "", "keyword_raw": "", "condition": "", "exception": "", "cross_ref": "", "cross_ref_status": "unknown", "normative_subject": "", "subject_span": 0}]}