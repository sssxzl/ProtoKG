+# ===========================================================================
+# R29-RA2/F2：文档级散文缓存（影子）
+# ===========================================================================
+#   ★ 与批次级旧缓存并存：旧文件（单协议单条目、complete=false）**一律不读**，
+#     76 条历史记录继续隔离；新缓存按 (协议, 文档) 分文件，各自独立完成状态。
+
+_DOC_CACHE_SCHEMA = "prose-cache-doc-v1"
+
+
+def _doc_cache_dir(protocol: str) -> Path:
+    return _cache_path(protocol).parent / f"{protocol}.prose.d"
+
+
+def _doc_cache_file(protocol: str, doc: str) -> Path:
+    safe = "".join(c if (c.isalnum() or c in "._-") else "_" for c in doc)
+    return _doc_cache_dir(protocol) / f"{safe}.json"
+
+
+def _doc_key(protocol: str, doc: str, text: str, parser_version: str) -> str:
+    """文档级缓存键：内容 + 实现版本 + prompt + 模型 + schema。"""
+    from core.fused.extraction.cache_key import cache_key as _ck, model_identity
+    fp = hashlib.sha256(f"{doc}\x00{text}".encode("utf-8")).hexdigest()
+    return _ck(prompt_version=PROSE_SEMANTICS_PROMPT_VERSION,
+               input_fingerprint=f"{doc}\x00{fp}", temperature=0.1,
+               max_tokens=_MAX_TOKENS, prompt_digest=_hash_text(_PROMPT),
+               parser_version=parser_version,
+               schema_version=_DOC_CACHE_SCHEMA)
+
+
+def _load_doc_caches(protocol: str, doc_texts: dict[str, str],
+                     parser_version: str) -> tuple[dict[str, list[dict]], set[str]]:
+    """按文档读缓存 ⇒ (命中文档的 items, 未命中文档集合)。只接受 complete=True。"""
+    hit: dict[str, list[dict]] = {}
+    miss: set[str] = set()
+    for doc, text in doc_texts.items():
+        f = _doc_cache_file(protocol, doc)
+        if not f.is_file():
+            miss.add(doc); continue
+        try:
+            d = json.loads(f.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            miss.add(doc); continue
+        if (d.get("schema") != _DOC_CACHE_SCHEMA or d.get("complete") is not True
+                or d.get("key") != _doc_key(protocol, doc, text, parser_version)):
+            miss.add(doc); continue
+        hit[doc] = list(d.get("items") or [])
+    return hit, miss
+
+
+def _save_doc_caches(protocol: str, doc_texts: dict[str, str], items: list[dict],
+                     parser_version: str, complete: bool) -> None:
+    """按文档写缓存；仅当该文档确有结果且本次运行完整时才标 complete。"""
+    by_doc: dict[str, list[dict]] = {d: [] for d in doc_texts}
+    for it in items or []:
+        d = it.get("doc")
+        if d in by_doc:
+            by_doc[d].append(it)
+    out_dir = _doc_cache_dir(protocol)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    for doc, text in doc_texts.items():
+        payload = {"schema": _DOC_CACHE_SCHEMA,
+                   "doc": doc,
+                   "doc_sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(),
+                   "key": _doc_key(protocol, doc, text, parser_version),
+                   "complete": bool(complete),
+                   "status": "success_nonempty" if by_doc[doc] else "success_empty",
+                   "items": by_doc[doc]}
+        f = _doc_cache_file(protocol, doc)
+        tmp = f.with_suffix(".json.tmp")
+        tmp.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
+        tmp.replace(f)
+
+
