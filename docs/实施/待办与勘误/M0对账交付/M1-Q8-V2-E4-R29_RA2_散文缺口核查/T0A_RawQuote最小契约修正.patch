+# ===========================================================================
+# R29-RA2/T0-A：quote 确定性定位（以冻结原文为权威，不看模型行号）
+# ===========================================================================
+def _norm_ws(t: str) -> str:
+    return re.sub(r"\s+", " ", (t or "")).strip().lower()
+
+
+def locate_quote(lines: list[str], quote: str) -> tuple[int | None, int | None, str]:
+    """把 quote 定位到原文行区间。
+
+    Returns: (start_line, end_line, status)
+    status ∈ exact_match / whitespace_normalized_match / ambiguous / quote_not_found
+    """
+    q_raw = (quote or "").strip()
+    if not q_raw:
+        return None, None, "quote_not_found"
+
+    # 原文按行拼接（保留换行），同时记录每行在拼接串中的起点
+    starts, buf = [], []
+    pos = 0
+    for i, ln in enumerate(lines, start=1):
+        starts.append((pos, i))
+        buf.append(ln)
+        pos += len(ln) + 1
+    text = "\n".join(buf)
+
+    # 1) 原文精确匹配（含换行）
+    hits = []
+    idx = text.find(q_raw)
+    while idx != -1:
+        hits.append(idx)
+        idx = text.find(q_raw, idx + 1)
+    status = "exact_match"
+    if not hits:
+        # 2) 空白归一化后匹配：只在单一空白形态差异时接受
+        ntext, nmap = [], []
+        for i, ch in enumerate(text):
+            if ch.isspace():
+                if ntext and ntext[-1] == " ":
+                    continue
+                ntext.append(" ")
+            else:
+                ntext.append(ch)
+            nmap.append(i)
+        nq = _norm_ws(q_raw)
+        joined = "".join(ntext).lower()
+        idx = joined.find(nq)
+        if idx == -1:
+            return None, None, "quote_not_found"
+        start_char = nmap[idx]
+        end_char = nmap[min(idx + len(nq) - 1, len(nmap) - 1)]
+        hits = [start_char]
+        status = "whitespace_normalized_match"
+        if joined.find(nq, idx + 1) != -1:
+            return None, None, "ambiguous"
+    else:
+        if len(hits) > 1:
+            return None, None, "ambiguous"
+        start_char, end_char = hits[0], hits[0] + len(q_raw) - 1
+
+    def _line_of(c):
+        lo = 0
+        for k, (p0, ln) in enumerate(starts):
+            if p0 > c:
+                return starts[k - 1][1] if k else 1
+        return starts[-1][1]
+
+    return _line_of(start_char), _line_of(end_char), status
+
