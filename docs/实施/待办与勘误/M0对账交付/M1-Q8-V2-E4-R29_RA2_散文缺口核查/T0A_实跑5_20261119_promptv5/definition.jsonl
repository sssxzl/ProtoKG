{"fact_key": {"protocol": "smtp", "version": "1.0", "subject": {"type": "actor", "name": "SMTP server", "qualifiers": {}, "path": []}, "aspect": "definition", "condition": {"type": "always"}}, "resolution": null, "all_claims": [{"claim_id": "c2_d0af0b590b9943ae", "fact_id": "f2_6ebb9b8192ed2599", "value": {"type": "struct", "data": {"meaning": "任何 SMTP 服务器都可以根据 TLS 协商期间提供的认证拒绝中继消息。"}}, "epistemic_type": "normative_unspecified", "authority": "rfc", "evidence_summary": ["rfc:prose_semantics_smtp server.c35bcd870717@file:rfc3207.txt#@138"], "confidence": null}]}
{"fact_key": {"protocol": "smtp", "version": "1.0", "subject": {"type": "actor", "name": "SMTP server", "qualifiers": {}, "path": []}, "aspect": "definition", "condition": {"type": "always"}}, "resolution": null, "all_claims": [{"claim_id": "c2_78bfb9d5ec18da1b", "fact_id": "f2_6ebb9b8192ed2599", "value": {"type": "struct", "data": {"meaning": "非公开引用的 SMTP 服务器可以根据 TLS 协商期间提供的认证拒绝任何中继或本地投递消息。"}}, "epistemic_type": "normative_unspecified", "authority": "rfc", "evidence_summary": ["rfc:prose_semantics_smtp server.5c58ad109186@file:rfc3207.txt#@139"], "confidence": null}]}
{"fact_key": {"protocol": "smtp", "version": "1.0", "subject": {"type": "actor", "name": "SMTP client", "qualifiers": {}, "path": []}, "aspect": "definition", "condition": {"type": "always"}}, "resolution": null, "all_claims": [{"claim_id": "c2_df5cd4c25ca4742c", "fact_id": "f2_c672f12b772444eb", "value": {"type": "struct", "data": {"meaning": "若协商结果无隐私、算法或密钥长度不够强、或认证不足，客户端可选择立即发送 QUIT 结束会话。"}}, "epistemic_type": "normative_unspecified", "authority": "rfc", "evidence_summary": ["rfc:prose_semantics_smtp client.23513af6a01a@file:rfc3207.txt#@300"], "confidence": null}]}
{"fact_key": {"protocol": "smtp", "version": "1.0", "subject": {"type": "protocol", "name": "TLS", "qualifiers": {}, "path": []}, "aspect": "definition", "condition": {"type": "always"}}, "resolution": null, "all_claims": [{"claim_id": "c2_58eca3dce8fb120b", "fact_id": "f2_2f31c8ce36b4c2e6", "value": {"type": "struct", "data": {"meaning": "实现可以提供记录与某对端通信时使用了 TLS、并在后续会话未使用时产生警告的能力。"}}, "epistemic_type": "normative_unspecified", "authority": "rfc", "evidence_summary": ["rfc:prose_semantics_tls.219bfe145b6a@file:rfc3207.txt#@316"], "confidence": null}]}
{"fact_key": {"protocol": "smtp", "version": "1.0", "subject": {"type": "protocol", "name": "TLS", "qualifiers": {}, "path": []}, "aspect": "definition", "condition": {"type": "always"}}, "resolution": null, "all_claims": [{"claim_id": "c2_e94f0949547beb79", "fact_id": "f2_2f31c8ce36b4c2e6", "value": {"type": "struct", "data": {"meaning": "若 TLS 协商失败或客户端收到 454 响应，客户端应尝试在后续会话中协商 TLS，直到本地选定的超时发生，届时应将邮件退回发件人。"}}, "epistemic_type": "normative_unspecified", "authority": "rfc", "evidence_summary": ["rfc:prose_semantics_tls.9a29fd6cf3d0@file:rfc3207.txt#@323"], "confidence": null}]}
