{"gold_knowledge_id": "GK-H3-02-1", "gold_level": "candidate", "candidate_id": "H3-02", "snippet_id": "H3-02", "status": "confirmed_valid", "★ 计入有效 Gold": true, "knowledge_kind": "normative_rule_candidate", "rule_eligibility": "eligible", "strength": "SHOULD", "polarity": "unavailable", "target_route": "rule_channel", "extract_completeness": "not_applicable", "evidence_span": "216-219", "source_sha256": "979728f8cb0563e764f3e5ac9dae08ad348fd6c24178eacab2e718522852d1f1", "source_document": "rfc3203.txt", "protocol": "DHCPv4", "evidence_text_sha256": "cde3f252254d62bcd728a89a9ade60f8647865aa949c81b6e67fb1e1b3488b27", "★ 适用的结构化字段": {"规范义务主体": {"value": "DHCP 客户端（client）", "source": "C 仲裁明确指定", "c_explicit": true, "needs_second_review": false}, "规范义务动作": {"value": "discard（静默丢弃）", "source": "C 仲裁明确指定", "c_explicit": true, "needs_second_review": false}, "条件": {"value": "failing the authentication（FORCERENEW 报文未通过认证）", "source": "C 仲裁明确指定（取 A 的原值）", "c_explicit": true, "needs_second_review": false}}, "★ 仲裁备注": [{"规范义务主体": "C 仲裁明确指定"}, {"规范义务动作": "C 仲裁明确指定"}, {"条件": "C 仲裁明确指定（取 A 的原值）"}], "★ 原始 A/B 标注": {"A 目标知识": "yes", "B 目标知识": "yes", "A 知识类型": "normative_rule_candidate", "B 知识类型": "normative_rule_candidate", "A 规则资格": "uncertain", "B 规则资格": "eligible", "A 强度": "unknown", "B 强度": "SHOULD", "A 完整性": "full", "B 完整性": "full", "A 路由": "pending_review", "B 路由": "rule_channel"}, "★ 仲裁记录": {"最终状态": "confirmed_valid", "仲裁人员/日期": "C / 2026-11-17"}, "★ 关键待裁裁定": {"最终状态": "arbitrated", "裁定结论": "yes", "证据与理由": "第219行「FORCERENEW messages failing the authentication should be silently discarded by the client.」判定：构成规范义务（yes）。依据：① 小写 should 是显式道义情态词，给出的是「建议」强度，不是「无强度线索」——硬规则①禁止的是无任何强度线索时猜 MUST，不含识别显式情态词；② 硬规则③明确承认无大写关键词的陈述式规范句，本句模态词直接落在 SHOULD 级；③ RFC 3203 §1.1（第46-48行）只有 RFC 2119 引用，不含 RFC 8174「仅当全大写才生效」的限制条款。故 strength=SHOULD、rule_eligibility=eligible、route=rule_channel，主体为客户端（by the client），条件为报文未通过认证。★ 若项目改用「仅大写关键词才赋强度」的严口径，本条应回退为 unknown + pending_review，但该口径会使硬规则③失效，本轮不采纳。", "仲裁人员/日期": "C / 2026-11-17"}, "★ 版本": "v3 候选（★ 未冻结，★ 待第三方复核后审批）", "★ 基于版本 SHA256": "f4bfbdb5da1746416321ff2f20bcbf070330fa606f79c0715fccd8545fec6044", "★ 基于版本": "H3_Gold冻结基线.jsonl（v1）", "★ 与 v2 的关系": "★ v3 用同一套修正后的解析规则从 v1 重算；★ 可与 v2 逐项比对", "★ polarity 说明": "★ 候选最终状态表未提供极性列；★ 逐字段差异表也无该字段的独立裁定行；★ 按要求标记 unavailable，★ 不做自动推断", "★ extract_completeness 仲裁原文": "", "★ extract_completeness 依据": "★ 该候选无抽取完整性差异行"}
{"gold_knowledge_id": "GK-H3-03-1", "gold_level": "candidate", "candidate_id": "H3-03", "snippet_id": "H3-03", "status": "confirmed_valid", "★ 计入有效 Gold": true, "knowledge_kind": "normative_rule_candidate", "rule_eligibility": "eligible", "strength": "MUST", "polarity": "unavailable", "target_route": "rule_channel", "extract_completeness": "not_applicable", "evidence_span": "216-219", "source_sha256": "979728f8cb0563e764f3e5ac9dae08ad348fd6c24178eacab2e718522852d1f1", "source_document": "rfc3203.txt", "protocol": "DHCPv4", "evidence_text_sha256": "cde3f252254d62bcd728a89a9ade60f8647865aa949c81b6e67fb1e1b3488b27", "★ 适用的结构化字段": {"规范义务主体": {"value": "DHCP 服务器（发送方，须加认证）", "source": "C 仲裁明确指定（仲裁：主体=X）", "c_explicit": true, "needs_second_review": false}, "规范义务动作": {"value": "authenticate", "source": "C 判定语义等价，取 A 表述", "c_explicit": true, "needs_second_review": false}, "规范义务对象": {"value": "using the procedures as described in [DHCP-AUTH]", "source": "C 判定语义等价，取 A 表述", "c_explicit": true, "needs_second_review": false}}, "★ 仲裁备注": [{"规范义务主体": "C 仲裁明确指定（仲裁：主体=X）"}], "★ 原始 A/B 标注": {"A 目标知识": "yes", "B 目标知识": "yes", "A 知识类型": "normative_rule_candidate", "B 知识类型": "normative_rule_candidate", "A 规则资格": "uncertain", "B 规则资格": "uncertain", "A 强度": "MUST", "B 强度": "MUST", "A 完整性": "partial", "B 完整性": "partial", "A 路由": "pending_review", "B 路由": "pending_review"}, "★ 仲裁记录": {"最终状态": "confirmed_valid", "仲裁人员/日期": "C / 2026-11-17"}, "★ 关键待裁裁定": {"最终状态": "arbitrated", "裁定结论": "yes", "证据与理由": "第217-218行「the FORCERENEW message MUST be authenticated using the procedures as described in [DHCP-AUTH].」大写 MUST 明确。主体判定：该句为被动式，但所在安全段（第216行「FORCERENEW can be used to snoop and spoof traffic」）表明认证由报文发出方施加；DHCP 中 FORCERENEW 由服务器发出，故规范义务主体=DHCP 服务器（发送方，须按 [DHCP-AUTH] 为报文加认证）。接收方校验义务由紧邻的第219句（H3-02）承担，两者不重复。据此 rule_eligibility=eligible、route=rule_channel、完整性=partial（主体须由同段语境推出，非逐字）。双方同为 uncertain 不构成「问题已解决」，本条给出确定主体。", "仲裁人员/日期": "C / 2026-11-17"}, "★ 版本": "v3 候选（★ 未冻结，★ 待第三方复核后审批）", "★ 基于版本 SHA256": "f4bfbdb5da1746416321ff2f20bcbf070330fa606f79c0715fccd8545fec6044", "★ 基于版本": "H3_Gold冻结基线.jsonl（v1）", "★ 与 v2 的关系": "★ v3 用同一套修正后的解析规则从 v1 重算；★ 可与 v2 逐项比对", "★ polarity 说明": "★ 候选最终状态表未提供极性列；★ 逐字段差异表也无该字段的独立裁定行；★ 按要求标记 unavailable，★ 不做自动推断", "★ extract_completeness 仲裁原文": "", "★ extract_completeness 依据": "★ 该候选无抽取完整性差异行"}
