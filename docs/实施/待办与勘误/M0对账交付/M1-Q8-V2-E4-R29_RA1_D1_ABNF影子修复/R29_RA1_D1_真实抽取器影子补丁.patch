     r'\bfield name\s+"([A-Za-z][A-Za-z0-9_-]*)"', re.IGNORECASE)
 
 
+#: ABNF 普通产生式：`name = rhs`（左部小写/连字符，非头字段形态）
+_RE_ABNF_PROD_START = re.compile(r"^[ \t]*([A-Za-z][A-Za-z0-9\-]{0,40})[ \t]*=[ \t]*(.*)$")
+#: 右部必须含 ABNF 特征，避免把正文里的等号误当定义
+_RE_ABNF_RHS_HINT = re.compile(r'%[xdXD]|["/\[\]()*]|;\s')
+#: 反例：右部是英文句子（含这些词且无 ABNF 结构符号）⇒ 不是产生式
+_RE_ABNF_SENTENCE = re.compile(
+    r"\b(is|are|the|this|that|using|defined|specified|means|denotes|given)\b",
+    re.IGNORECASE)
+
+
+def _looks_like_production(name: str, rhs: str) -> bool:
+    """ABNF 产生式判据（名字小写 + 右部结构符号 + 非英文句子）。"""
+    if not re.fullmatch(r"[a-z][a-z0-9\-]{0,40}", name):
+        return False
+    if not _RE_ABNF_RHS_HINT.search(rhs):
+        return False
+    # 代码片段（C 示例）不是 ABNF；先剥掉引号字面量，避免 "{" / "}" 误伤
+    _nq = re.sub(r'"[^"]*"', '""', rhs)
+    if re.search(r"return\s*\(|\+\+|->|\{|\}|printf|malloc|#include", _nq):
+        return False
+    # C 风格标识符（下划线命名）不是 ABNF 规则名
+    if re.search(r"\b[a-z]+_[a-z0-9_]+\b", _nq):
+        return False
+    # 有 ABNF 强特征时放行（%x / 引号字面量 / 方括号 / 星号重复）
+    strong = re.search(r'%[xdXD]|"|\[|\*', rhs)
+    if strong and not _RE_ABNF_SENTENCE.search(rhs):
+        return True
+    if strong and _RE_ABNF_SENTENCE.search(rhs) and "/" in rhs:
+        return True
+    return False
+
+
+def _extract_abnf_productions(content_lines: list[tuple[int, str]]) -> list[dict]:
+    """抽 ABNF **语法产生式**（`npt-range = ...` 这类），保留跨行续写。
+
+    R29-RA1/D1 影子实验：仅产出候选 Norm，不进入正式映射。
+    判据（全部满足）：
+      · 行首为规则名 + `=`，且不是头字段形态（`name = "Header:" ...`）
+      · 右部含 ABNF 特征（%x / 引号 / 斜杠 / 方括号 / 圆括号 / 注释）
+      · 非目录行（无点引导）
+      · 续行以空白开头且本身不是新规则
+    """
+    out: list[dict] = []
+    seen: set[str] = set()
+    i = 0
+    lines = content_lines
+    while i < len(lines):
+        ln, raw = lines[i]
+        i += 1
+        if ".." in raw:
+            continue
+        m = _RE_ABNF_PROD_START.match(raw)
+        if not m:
+            continue
+        name, rhs = m.group(1), m.group(2).strip()
+        if name.lower() in seen:
+            continue
+        cont: list[str] = []
+        j = i
+        while j < len(lines):
+            nxt = lines[j][1]
+            if not nxt.strip() or not nxt[:1].isspace():
+                break
+            if _RE_ABNF_PROD_START.match(nxt.strip()):
+                break
+            # 注释块（;; ...）属于说明，不是 ABNF 续行
+            if nxt.strip().startswith(";;"):
+                break
+            cont.append(nxt.strip())
+            j += 1
+        full = " ".join([rhs] + cont).strip()
+        if not _looks_like_production(name, full):
+            continue
+        seen.add(name.lower())
+        out.append({"name": name, "rhs": full, "line": ln})
+    return out
+
+
