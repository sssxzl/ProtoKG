{"kind": "semantic_rule", "rule": {"rule_id": "r945e5e8ce213fdef", "evidence": {"evidence_id": "e7719f76f94e5", "spec_version": "RFC 5322", "section_path": ["Syntax", "Field Definitions", "Originator Fields"], "source_anchor": "file:rfc5322.txt#@1280", "span_text": "In all cases, the \"From:\" field SHOULD NOT contain any mailbox that\n   does not belong to the author(s) of the message.", "span_start": 51538, "span_end": 51657, "evidence_kind": "normative", "explicitness": "quoted", "source_class": "normative_spec"}, "constraint": {"target_field": "From", "operator": "absent", "operand": [], "operand_source": "constant", "operand_ref": null, "applies_to_state": [], "applies_to_method": [], "expected_behavior": "", "sender_role": "client", "receiver_role": "server", "precondition": null}, "subject_type": "field", "subject_name": "From", "rule_state": "authoritative", "supersedes": null, "model_confidence": 1.0, "validated": true}}
