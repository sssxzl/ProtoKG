{"kind": "semantic_rule", "rule": {"rule_id": "re7eb13d02b810fc4", "evidence": {"evidence_id": "ea73a07fc3b1e", "spec_version": "RFC 5322", "section_path": ["Syntax", "Field Definitions", "Originator Fields"], "source_anchor": "file:rfc5322.txt#@1275", "span_text": "In the absence of the \"Reply-To:\" field,\n   replies SHOULD by default be sent to the mailbox(es) specified in the\n   \"From:\" field unless otherwise specified by the person composing the\n   reply.", "span_start": 51338, "span_end": 51533, "evidence_kind": "normative", "explicitness": "quoted", "source_class": "normative_spec"}, "constraint": {"target_field": "Reply-To", "operator": "absent", "operand": [], "operand_source": "constant", "operand_ref": null, "applies_to_state": [], "applies_to_method": [], "expected_behavior": "", "sender_role": "client", "receiver_role": "server", "precondition": null}, "subject_type": "field", "subject_name": "Reply-To", "rule_state": "authoritative", "supersedes": null, "model_confidence": 1.0, "validated": true}}
{"kind": "semantic_rule", "rule": {"rule_id": "re3ba02d34501266e", "evidence": {"evidence_id": "e7b970559cecf", "spec_version": "RFC 5322", "section_path": ["Syntax", "Field Definitions", "Resent Fields"], "source_anchor": "file:rfc5322.txt#@1576", "span_text": "\"Resent-Sender:\" SHOULD NOT be used if \"Resent-Sender:\" would be\n   identical to \"Resent-From:\".", "span_start": 65362, "span_end": 65458, "evidence_kind": "normative", "explicitness": "quoted", "source_class": "normative_spec"}, "constraint": {"target_field": "Resent-Sender", "operator": "ne", "operand": ["Resent-From"], "operand_source": "constant", "operand_ref": null, "applies_to_state": [], "applies_to_method": [], "expected_behavior": "", "sender_role": "client", "receiver_role": "server", "precondition": null}, "subject_type": "field", "subject_name": "Resent-Sender", "rule_state": "authoritative", "supersedes": null, "model_confidence": 1.0, "validated": true}}
